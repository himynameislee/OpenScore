# Scan output — contains client data. Never commit.
reports/
*.audit.log
*.suppressions-template.toml
# Real suppression files are client-specific; only the example is tracked
suppressions/*.toml
!suppressions/example.com.toml.example

# Bundled Windows tools
tools/

